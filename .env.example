# 初始化脚本会在生成的 .env 中追加 COMPOSE_PROJECT_NAME
# 多个项目同时运行时，请为每个项目设置不同的 SSH 端口
SSH_PORT=2233

# 构建时的代理配置，请按本机环境修改
USE_PROXY=true
PROXY_IP=192.168.3.70
PROXY_PORT=7890
PROXY_USER=
PROXY_PASS=

USE_CHINA_APT_MIRROR=true
USE_CHINA_NPM_MIRROR=true

# 宿主机项目路径，相对路径以 compose.yaml 所在目录为基准
WORKSPACE_SOURCE=..

# 容器内挂载位置及工作目录
WORKSPACE_DIRD=/home/agent/workspace
